{
  "name": "dsh-command-shortcut",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH 插件：在输入框工具行加一个「快捷指令」按钮，点开列出常用提示词，点一条即填入输入框且不自动发送",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
